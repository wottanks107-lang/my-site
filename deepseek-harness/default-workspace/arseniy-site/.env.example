# Скопируй этот файл в .env.local и укажи свои значения.
# .env.local не попадает в git — секреты не утекут.

# --- Вход в админку / dashboard ---------------------------------------------
ADMIN_PASSWORD=change-me
# Случайная строка для подписи cookie-сессии:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-too

# --- Supabase (Project Settings → API) --------------------------------------
# Публичные значения — их видно в браузере, это нормально.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# СЕКРЕТ. Даёт полный доступ к базе и обходит RLS.
# Только на сервере. НИКОГДА не добавляй сюда префикс NEXT_PUBLIC_
# и никогда не коммить этот файл.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
